# ============================================================
# Prime Home Devis — Variables d'environnement
# Copier ce fichier en .env et renseigner toutes les valeurs
# NE JAMAIS committer le fichier .env dans git
# ============================================================

# ── Base de données PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://devis_user:CHANGEME_mot_de_passe_fort@devis_db:5432/devis_miele

# ── JWT ──────────────────────────────────────────────────────
# DOIT être identique au JWT_SECRET_KEY de l'ERP (token partagé)
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGEME_minimum_32_caracteres_secret_aleatoire

# ── Communication inter-services ──────────────────────────────
# URL interne de l'ERP Order Tracking (sur le même réseau Docker)
ORDER_TRACKING_URL=http://erp_api:8000
ORDER_TRACKING_TOKEN=

# ── Odoo (lecture seule) ──────────────────────────────────────
ODOO_URL=https://odoo.primehome.ma
ODOO_DB=odoo
ODOO_USER=erp_readonly@primehome.ma
ODOO_PASSWORD=CHANGEME_mot_de_passe_odoo

# ── App ──────────────────────────────────────────────────────
DEBUG=false

# ── Société Prime Home (non sensibles) ───────────────────────
COMPANY_NAME=PRIME HOME SARL
COMPANY_CAPITAL=300 000 DH
COMPANY_ADDRESS=413, Route Al Jamiaa (ex Route Eljadida), Oasis Casablanca
COMPANY_TEL=+212 522 254 732
COMPANY_EMAIL=contact@prime-home.ma
COMPANY_WEBSITE=https://www.miele.co.ma
